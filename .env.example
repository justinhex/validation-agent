# How to add more role：add <ROLE>_BASE_URL、<ROLE>_MODEL、<ROLE>_API_KEY，NO CODE SHOULD BE CHANGED!
# This is an example of .env should look like
PLANNER_BASE_URL=http://localhost:11434/v1
PLANNER_MODEL=qwen2.5-coder:7b
PLANNER_API_KEY=ollama
HIL_BASE_URL=http://localhost:11434/v1
HIL_MODEL=qwen2.5-coder:7b
HIL_API_KEY=ollama
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192
LLM_NUM_CTX=8192
LLM_TIMEOUT_S=120
MAX_REVIEW_ATTEMPTS=3
MCP_CALL_BUDGET=20
PYTEST_TIMEOUT_S=600
CHECKPOINT_PATH=.checkpoints/checkpoints.sqlite
# LANGSMITH_API_KEY=        # use only enabled tracing
# LANGSMITH_TRACING=false